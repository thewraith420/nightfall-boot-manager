#!/bin/sh
# PID 1 for the picker initramfs: bring up just enough of the system to
# read /boot, discover real kernels, run the touch menu, and kexec.

mount -t proc none /proc
mount -t sysfs none /sys
mount -t devtmpfs none /dev
mkdir -p /dev/pts
mount -t devpts none /dev/pts

# Needed for boot-external-drive.sh's efibootmgr to read/write NVRAM
# boot variables at all - not mounted automatically without systemd.
# Best-effort: a BIOS-only machine (or a kernel without CONFIG_EFIVAR_FS)
# has no /sys/firmware/efi to mount here, which just means efibootmgr
# fails later and that path warns instead of ending Nightfall.
mkdir -p /sys/firmware/efi/efivars 2>/dev/null
mount -t efivarfs efivarfs /sys/firmware/efi/efivars 2>/dev/null || true

# Needed for kexec-preflight.sh to read the lockdown state
# (/sys/kernel/security/lockdown). Best-effort like the above: without it the
# preflight just cannot tell, which it treats as "not blocked".
mount -t securityfs securityfs /sys/kernel/security 2>/dev/null || true

mdev -s

mkdir -p /run/nightfall /mnt/root

# Where the boot files (grub.cfg, loader/entries, vmlinuz-*, and Nightfall's own
# nightfall-* settings) live under /mnt/root. On every machine so far /boot is a
# directory on the real root. When /boot is its own partition, find-real-root.sh
# reports the layout "bootfs", /mnt/root IS the boot partition, and this is
# switched to /mnt/root once it is mounted. Until then it names the usual place,
# which does not exist yet - so "is the root mounted" checks still mean that.
BOOTDIR=/mnt/root/boot
BOOT_LAYOUT=rootfs

# kexec-boot.sh correctly refuses to run with a missing linux path
# (set -eu, ${2:?}) - but since it's exec'd below in place of PID 1,
# that clean refusal becomes "Attempted to kill init!" instead of
# anything recoverable. So every stage that could leave
# SELECTED_LINUX empty needs to be caught here first, with a real
# fallback - either the first discovered kernel (same "first entry is
# the default" convention NIGHTFALL_TIMEOUT_SECS uses in ui/nightfall.c) or,
# if there's no discovered kernel to fall back to at all, a rescue
# shell instead of letting init exit and panic. Found and verified via
# a standalone control-flow test (not hardware-dependent - pure shell
# logic) after real-hardware code review turned up the gap.
# Everything this script does happens in a window with no journal, no
# scrollback and - on the fallback paths - no user-visible output at
# all. That silence is deliberate: falling back straight into a working
# kernel beats stranding someone at a prompt. But from the outside it is
# indistinguishable from "the GRUB selection never took", which is
# exactly what the first real boot attempt looked like: straight to the
# desktop, no menu, nothing left behind to say why. Losing an entire
# boot attempt to no evidence is worse than the few hundred ms this
# costs, so: record what happened somewhere that survives the kexec.
#
# Strictly best-effort. Every step can fail and the boot continues -
# diagnostics must never be the reason a machine doesn't come up.
BOOT_LOG=""   # set in save_log(), once BOOTDIR is known
stages=""
# Two kinds of progress line, and only one belongs on the screen.
#
# stage: routine progress - "mounting real root", "discovering kernels".
# Recorded in the boot log, where it is useful, and NOT printed to the
# console, where it was a screenful of scrolling text between GRUB and
# the menu, and again between the menu and the kernel. NIGHTFALL_VERBOSE=1
# on the kernel command line (GRUB's 'e' editor, with a keyboard) puts it
# back on screen for debugging.
#
# warn: something a person looking at the tablet should see - a device
# that has not appeared yet, a setting that was ignored, a fallback.
# Always printed. Quiet must never hide a problem.
#
# The loud, deliberate blocks - install progress, the fallback banner,
# the rescue shell - echo directly and are untouched by either.
# Each boot-log line carries seconds since boot, so a single boot shows
# where the time between GRUB and the menu actually goes. /proc/uptime,
# not date: date has one-second resolution and there is no clock yet.
_up() { cut -d' ' -f1 /proc/uptime 2>/dev/null || echo "?"; }
stage() {
    stages="${stages}  - [$(_up)] $1
"
    [ -n "${NIGHTFALL_VERBOSE:-}" ] && echo "nightfall: $1" >&2
    return 0
}
warn() {
    stages="${stages}  - [$(_up)] $1
"
    echo "nightfall: $1" >&2
}

# Nightfall keeps drawing a booting screen after it exits, from a child
# that holds the display through the handoff to the kernel. A path that
# needs the console back must take the screen back first, or its message
# is printed behind a spinner nobody can see past. Text printed while the
# display is held is not lost - the console redraws when it is released -
# so releasing first is enough; no pause is needed.
BOOTING_PID=/run/nightfall/booting.pid
release_display() {
    [ -f "$BOOTING_PID" ] || return 0
    kill "$(cat "$BOOTING_PID" 2>/dev/null)" 2>/dev/null
    rm -f "$BOOTING_PID"
    return 0
}

# As PID 1 we are in a footrace with driver probe: a real boot log shows
# init reaching picker within ~0.85s of the kernel starting, while
# devices are still enumerating. Run by hand on a booted system
# everything settled minutes ago, which is why none of this appeared in
# testing.
#
# What init waits for here is the ROOT DEVICE only - the one device it
# owns the criteria for ("can I mount it"). picker does its own waiting
# for DRM and touch, because only it knows what a usable one looks like.
#
# Never fatal: on timeout we carry on and let the normal failure path
# report it, since a wrong guess here should not strand anyone.
have_any() {
    for _f in $1; do [ -e "$_f" ] && return 0; done
    return 1
}

# $1 = description, $2 = name of a predicate function, $3 = seconds.
wait_until() {
    _n=0
    "$2" && return 0
    warn "waiting for $1"
    while [ "$_n" -lt "$3" ]; do
        sleep 1
        _n=$((_n + 1))
        if "$2"; then
            stage "$1 appeared after ${_n}s"
            return 0
        fi
    done
    warn "TIMEOUT: $1 never appeared after ${3}s"
    return 1
}

# Path/glob flavour of the above. POSIX sh has no closures, so the
# pattern goes through a global the predicate reads.
_wait_glob=""
_have_wait_glob() { have_any "$_wait_glob"; }
wait_for() { _wait_glob=$2; wait_until "$1 ($2)" _have_wait_glob "$3"; }

# $1 = outcome summary. Writes the log to the real root, which is
# mounted read-only, so this borrows the same brief remount dance
# apply-default uses (see below) - and puts it back read-only after.
save_log() {
    [ -d "$BOOTDIR" ] || {
        echo "nightfall: (real root not mounted - cannot save a boot log)" >&2
        return 0
    }
    BOOT_LOG=$BOOTDIR/nightfall-last-boot.log
    mount -o remount,rw /mnt/root 2>/dev/null || {
        echo "nightfall: (could not remount rw - cannot save a boot log)" >&2
        return 0
    }
    {
        echo "=== Nightfall boot log ==="
        echo "outcome:  $1"
        echo "when:     $(date 2>/dev/null || echo '(no clock)')"
        echo "kernel:   $(uname -r 2>/dev/null)"
        echo
        echo "--- stages reached ---"
        printf '%s' "$stages"
        echo
        # Every drive scan this boot ran - the one at startup AND each
        # Rescan from the menu - with the reason for each drive it kept or
        # skipped. Without this a Rescan that finds nothing looks exactly
        # like one that never ran.
        echo "--- drive scans (startup and every Rescan) ---"
        if [ -s /run/nightfall/scan.log ]; then cat /run/nightfall/scan.log; else echo "(no scan output)"; fi
        echo
        # What the two external-boot paths printed when they were tried -
        # the drive's efibootmgr calls and the ISO's kexec steps. Both went
        # only to the screen before, so a failure was unrecoverable from the
        # log afterwards.
        echo "--- external drive (BootNext) attempts ---"
        if [ -s /run/nightfall/boot-external.log ]; then cat /run/nightfall/boot-external.log; else echo "(none)"; fi
        echo
        echo "--- live ISO attempts ---"
        if [ -s /run/nightfall/live-boot.log ]; then cat /run/nightfall/live-boot.log; else echo "(none)"; fi
        echo
        echo "--- selection ---"
        # "user" vs "timeout" matters: a boot where the panel stayed
        # dark and the timeout fired looks, downstream, exactly like one
        # where someone chose an entry. It reported "booted user
        # selection" for a boot nobody could even see.
        echo "chosen_by=${SELECTED_BY:-unknown}"
        echo "linux=${SELECTED_LINUX:-}"
        echo "initrd=${SELECTED_INITRD:-}"
        echo "cmdline=${SELECTED_CMDLINE:-}"
        echo
        # The display accelerometer, for auto-rotate. Logged rather than
        # acted on: the mapping from sensor axes to screen orientation
        # depends on how the chip is mounted relative to the panel, and
        # that takes one observation on the real tablet rather than any
        # amount of reasoning. Held upright LANDSCAPE is ROT_0 and
        # upright PORTRAIT is ROT_270 (Bob, confirmed), so a reading
        # taken in a known orientation pins the whole table.
        #
        # Silent when there is no sensor, so this costs nothing on a
        # kernel without the cros-ec IIO chain - which is every picker
        # kernel before 2026-09-12.
        echo "--- display accelerometer (auto-rotate calibration) ---"
        _accel_found=
        for _d in /sys/bus/iio/devices/iio:device*; do
            [ -e "$_d/name" ] || continue
            _n=$(cat "$_d/name" 2>/dev/null)
            _l=$(cat "$_d/label" 2>/dev/null || echo "")
            echo "  $_d name=$_n label=$_l"
            case "$_n" in
              *accel*)
                _accel_found=1
                for _c in in_accel_x_raw in_accel_y_raw in_accel_z_raw in_accel_scale; do
                    [ -e "$_d/$_c" ] && echo "    $_c=$(cat "$_d/$_c" 2>/dev/null)"
                done ;;
            esac
        done
        [ -n "$_accel_found" ] || echo "  (no accelerometer - kernel lacks the cros-ec IIO chain)"
        echo
        # If picker never drew anything, the reason is usually that one
        # of these is simply absent - which is instant to see here and
        # near-impossible to guess at from a blank screen.
        echo "--- /dev/dri (DRM - Nightfall cannot draw without this) ---"
        ls -l /dev/dri 2>&1 || true
        echo
        echo "--- /dev/input (touch) ---"
        ls -l /dev/input 2>&1 || true
        echo
        # The definitive account of what the input layer actually
        # registered, with capabilities - this is the file that settled
        # the earlier "five Wacom sub-interfaces" confusion. If touch
        # never enumerates, its absence here is the proof; if it
        # enumerates but picker rejects it, the EV/ABS bits say why.
        echo "--- /proc/bus/input/devices ---"
        cat /proc/bus/input/devices 2>/dev/null || echo "(unavailable)"
        echo
        # Did the I2C bus the touch controller hangs off even come up?
        echo "--- /sys/bus/i2c/devices ---"
        ls /sys/bus/i2c/devices 2>&1 || true
        echo
        if [ -s /run/nightfall/install.log ]; then
            echo "--- kernel install output ---"
            cat /run/nightfall/install.log 2>/dev/null
            echo
        fi
        echo "--- nightfall exit code: ${nightfall_rc:-n/a} ---"
        echo "--- nightfall stderr ---"
        cat /run/nightfall/nightfall.stderr 2>/dev/null || echo "(none captured)"
        echo
        echo "--- menu.tsv (first 5 of $(cat /run/nightfall/menu.tsv 2>/dev/null | wc -l 2>/dev/null) entries) ---"
        head -n5 /run/nightfall/menu.tsv 2>/dev/null || echo "(no menu)"
        echo
        # Pulled out first, because the whole dmesg below is long and
        # the question is nearly always "did this device's driver bind".
        echo "--- hardware probe lines (i2c/hid/input/drm/mmc) ---"
        dmesg 2>/dev/null | grep -iE "i2c|hid|input|wacom|designware|drm|i915|mmc|elan|atmel" \
            || echo "(no matching lines - the driver never logged anything)"
        echo
        # NOT tailed. This started as `tail -n150` and that window turned
        # out to span 14.4s-34.4s on a real failure: early boot, where
        # I2C/HID probe, had scrolled out entirely - flooded away by
        # repeating "PCIe Bus Error: severity=Correctable" lines - so the
        # log could not answer the one question being asked of it. The
        # ring buffer is bounded anyway; a generous cap beats a window
        # positioned exactly where the answer isn't.
        echo "--- dmesg (full, up to 2000 lines) ---"
        dmesg 2>/dev/null | head -n2000 || echo "(dmesg unavailable)"
    } > "$BOOT_LOG" 2>/dev/null || \
        echo "nightfall: (failed to write $BOOT_LOG)" >&2
    # Flush before kexec: the new kernel does not replay this page cache.
    sync 2>/dev/null || true
    mount -o remount,ro /mnt/root 2>/dev/null || true
    return 0
}

rescue() {
    release_display
    save_log "rescue: $1"
    echo "nightfall: $1" >&2
    echo "nightfall: dropping to a rescue shell" >&2
    exec /bin/sh
}

# This SAME initramfs image can now be booted from more than one disk on
# the same machine - Bob's portable recovery/toolkit USB stick carries its
# own Nightfall install, right alongside the Slate's internal one - so the
# historical assumption "REAL_ROOT_DEV is always the internal eMMC" no
# longer holds. By the time this runs, GRUB has already handed off with no
# memory of which physical partition it actually loaded this from, so
# find-real-root.sh self-discovers it: walk every candidate partition,
# mount each read-only, and look for the SAME build id this initramfs was
# stamped with at build time (/etc/nightfall-build-id) - see that script's
# own header. REAL_ROOT_DEV set some other way first (a kernel cmdline
# override, for manual debugging via GRUB's 'e' editor) is left alone.
#
# Root and /boot are the same partition on every machine this has run on
# (the Slate's internal eMMC, and Bob's stick) - no separate /boot mount -
# which is what makes "the partition with a matching /boot/nightfall"
# and "the real root" the same question for now. No LABEL is set on the
# Slate's eMMC, and busybox mdev doesn't populate /dev/disk/by-uuid
# without a custom blkid-driven rule, so this self-discovery walks raw
# device paths rather than by-label/by-uuid - the same reason the old
# hardcoded default was a raw path too.
if [ -z "${REAL_ROOT_DEV:-}" ]; then
    my_build_id=""
    if [ -r /etc/nightfall-build-id ]; then
        # `|| :`, NOT `|| my_build_id=""` - build-initramfs.sh writes this
        # file with a bare printf, no trailing newline, and `read` on a
        # newline-less file returns 1 AT EOF even though it assigned the
        # value correctly. The old `|| my_build_id=""` treated that
        # nonzero status as "nothing was read" and wiped the id right
        # back out - which is exactly what made every roaming build look
        # id-less and silently fall back to the Slate's internal eMMC,
        # the one thing this whole feature exists to stop. Found on real
        # hardware, not anticipated: the file already exists and is
        # readable by the time this runs, so nothing else can fail here.
        read -r my_build_id < /etc/nightfall-build-id 2>/dev/null || :
    fi
    if [ -n "$my_build_id" ]; then
        stage "looking for the disk this install actually lives on"
        # Bounded the same as the old single-device wait below (storage
        # enumeration is not instant) - this loop runs INSTEAD of that
        # wait when discovery succeeds, since find-real-root.sh already
        # had to mount the device to confirm the match.
        _n=0
        found=""
        while :; do
            found=$(/bin/find-real-root.sh "$my_build_id" 2>/dev/null) || found=""
            [ -n "$found" ] && break
            _n=$((_n + 1))
            [ "$_n" -gt "${NIGHTFALL_WAIT_ROOT:-15}" ] && break
            sleep 1
        done
        if [ -n "$found" ]; then
            # "<device> <layout>". No set -- here: init has no use for its
            # positional parameters, but clobbering them is a trap left for
            # whoever adds one. A bare device (an older find-real-root.sh)
            # has no space, so ${found#* } returns it unchanged - treated as
            # the historical layout.
            REAL_ROOT_DEV=${found%% *}
            BOOT_LAYOUT=${found#* }
            [ "$BOOT_LAYOUT" = "$found" ] && BOOT_LAYOUT=rootfs
            stage "found it: $REAL_ROOT_DEV ($BOOT_LAYOUT)"
        else
            # NOT the hardcoded-eMMC fallback below - a build carrying an
            # id is explicitly one meant to roam (Bob's portable stick),
            # so "fall back to /dev/mmcblk0p2" here would mean silently
            # mounting - and logging to, and scanning - whatever real
            # disk happens to answer to that name on WHATEVER machine
            # this is currently plugged into. On most PCs that path
            # simply does not exist and this would have failed loudly
            # anyway, but another eMMC device (another Chromebook) could
            # have a real /dev/mmcblk0p2 of its own - and silently
            # touching a stranger's internal disk is a worse outcome than
            # a rescue shell. Caught during real hardware testing, not
            # anticipated up front.
            warn "could not find a disk matching this build after ${NIGHTFALL_WAIT_ROOT:-15}s"
            rescue "this build is meant to run on more than one machine - refusing to guess and mount whatever disk happens to answer to the historical default name"
        fi
    else
        warn "no /etc/nightfall-build-id in this image (built by an older build-initramfs.sh) - falling back to the internal eMMC"
    fi
fi
# Only reached now by an old, id-less image (never meant to roam - the
# only place it was ever installed IS the Slate) or an explicit override
# set some other way; a roaming build that failed to self-discover has
# already gone to rescue above rather than reach this line at all.
#
# EXPORTED, not just set. Nightfall reads it with getenv() to hand the
# real root device to scan-drives.sh and to the repair actions - and
# without the export it silently got NULL and fell back to a hardcoded
# /dev/mmcblk0p2. That happened to be correct on the Slate, which is
# exactly why it went unnoticed for as long as it did; a filesystem
# checker must not run on a device chosen by a lucky default.
: "${REAL_ROOT_DEV:=/dev/mmcblk0p2}"
export REAL_ROOT_DEV
# eMMC probe is not instant, and a root mount that fails here drops
# straight to the rescue shell - the harshest outcome in the script. A
# no-op the moment self-discovery above already found and mounted it.
wait_for "root device" "$REAL_ROOT_DEV" "${NIGHTFALL_WAIT_ROOT:-15}"
stage "mounting real root ($REAL_ROOT_DEV)"
if ! mount -o ro "$REAL_ROOT_DEV" /mnt/root; then
    rescue "failed to mount real root ($REAL_ROOT_DEV)"
fi

if [ "$BOOT_LAYOUT" = bootfs ]; then
    # The partition we just mounted is /boot itself: there is no boot/ under it.
    BOOTDIR=/mnt/root
    # Kernel install/remove write $root/boot/..., which on a boot-only mount
    # would create a stray boot/ directory on the wrong filesystem. The UI
    # hides those rows on this.
    NIGHTFALL_BOOT_ONLY=1
    export NIGHTFALL_BOOT_ONLY
    stage "/boot is its own partition: boot files are at the top of it"
fi

# Which kernels can be booted. Tried in order, first one to yield anything wins:
#   1. $BOOTDIR/grub/grub.cfg    Debian, Ubuntu, Arch, the Slate - tried first
#                                so nothing that worked before changes
#   2. $BOOTDIR/grub2/grub.cfg   Fedora, RHEL, openSUSE
#   3. $BOOTDIR/loader/entries   Boot Loader Specification: Fedora/RHEL put
#                                their kernels here and leave grub.cfg with
#                                only a blscfg command and no menuentries
# Fills menu.tsv.raw; status is whether it is non-empty.
discover_kernels() {
    : > /run/nightfall/menu.tsv.raw
    /bin/discover-kernels.sh "$BOOTDIR/grub/grub.cfg" > /run/nightfall/menu.tsv.raw 2>/dev/null || :
    # grub.cfg's `source .../custom.cfg` is a runtime directive, not an
    # include - GRUB never inlines custom.cfg's text into grub.cfg, so a
    # menuentry that lives only in custom.cfg is invisible to the parser
    # above. That includes Nightfall's OWN entry: install-nightfall.sh
    # deliberately writes it to custom.cfg, which made the --id
    # nightfall/picker self-exclusion in discover-kernels.sh dead code on
    # every distro that works this way (confirmed on the Slate). Parse
    # custom.cfg too, when grub.cfg actually sources it, so both a user's
    # own custom.cfg entries and the self-exclusion are real.
    if [ -r "$BOOTDIR/grub/custom.cfg" ] && grep -q 'custom\.cfg' "$BOOTDIR/grub/grub.cfg" 2>/dev/null; then
        /bin/discover-kernels.sh "$BOOTDIR/grub/custom.cfg" >> /run/nightfall/menu.tsv.raw 2>/dev/null || :
    fi
    [ -s /run/nightfall/menu.tsv.raw ] && return 0
    if [ -r "$BOOTDIR/grub2/grub.cfg" ]; then
        /bin/discover-kernels.sh "$BOOTDIR/grub2/grub.cfg" > /run/nightfall/menu.tsv.raw 2>/dev/null || :
        [ -s /run/nightfall/menu.tsv.raw ] && return 0
    fi
    /bin/discover-bls.sh "$BOOTDIR" > /run/nightfall/menu.tsv.raw 2>/dev/null || :
    [ -s /run/nightfall/menu.tsv.raw ]
}

stage "discovering kernels (grub.cfg, grub2, boot loader entries)"
if ! discover_kernels; then
    rescue "no kernel entries found (no usable grub/grub.cfg, grub2/grub.cfg or loader/entries under ${BOOTDIR#/mnt/root}/)"
fi

# Moves a previously "Set Default"-marked entry to the front, if it's
# still present - see apply-default.sh. A missing/stale marker just
# passes the list through unchanged.
DEFAULT_MARKER=$BOOTDIR/nightfall-default
CMDLINE_FILE=$BOOTDIR/nightfall-cmdline
TIMEOUT_FILE=$BOOTDIR/nightfall-timeout

# The menu timeout, settable without rebuilding the initramfs.
#
# It lives on the real root next to the other things Nightfall
# remembers, for the same reason they do: an initramfs rebuild replaces
# every file in the image, so a number baked in there is lost every time
# the UI changes. On the root it survives, and it can be changed by
# anything that can write to /boot - which on a keyboardless tablet
# means a tool with a GUI rather than an editor.
#
# VALIDATED HARD, and this is the one knob where that really matters.
# Nightfall treats 0 as "disable the auto-boot entirely", so a stray
# newline or a comment turning into 0 would not merely be wrong - it
# would leave the machine sitting at a menu forever if touch were not
# working, which is precisely the situation the timeout exists to
# rescue. So: digits only, nothing else, and anything unexpected is
# treated as though the file were absent.
#
# 0 itself stays legal, because it is a documented choice someone can
# deliberately make. The guard is against garbage BECOMING 0, not
# against meaning it.
if [ -f "$TIMEOUT_FILE" ]; then
    # `read`, not `head | tr`: tr is NOT one of the applets in this
    # image, so the strip silently produced nothing and every valid
    # timeout was rejected as garbage. Caught only by the busybox pass
    # with the host PATH removed - on the build laptop tr exists and it
    # looked fine. read is a shell builtin, always there, and strips
    # surrounding whitespace via IFS for free.
    _t=""
    # `|| :`, not `|| _t=""` - see the build-id read above: a
    # newline-less file makes read return 1 at EOF despite
    # assigning the value correctly, and the old pattern wiped it.
    read -r _t < "$TIMEOUT_FILE" 2>/dev/null || :
    case "$_t" in
        ''|*[!0-9]*)
            warn "ignoring $TIMEOUT_FILE: not a plain number" ;;
        *)
            # Upper bound as a sanity check rather than a policy: an
            # hour of waiting is indistinguishable from a hang, and a
            # value that large is far more likely a typo than intent.
            if [ "$_t" -le 3600 ]; then
                NIGHTFALL_TIMEOUT_SECS=$_t
                export NIGHTFALL_TIMEOUT_SECS
                stage "menu timeout ${_t}s (from nightfall-timeout)"
            else
                warn "ignoring $TIMEOUT_FILE: ${_t}s is out of range"
            fi ;;
    esac
fi

# menu.tsv.raw -> menu.tsv. Shared by the initial build and by
# refresh_menu after an install, so the two cannot drift apart.
build_menu_files() {
    /bin/apply-default.sh /run/nightfall/menu.tsv.raw "$DEFAULT_MARKER" > /run/nightfall/menu.tsv.def

    # Then each kernel's saved command line, if it has one. picker reads
    # the result straight out of the cmdline field, so what the Edit
    # screen shows is exactly what will be booted - one source of truth.
    # Best-effort: on failure the menu is simply what apply-default
    # produced, which is always bootable.
    if /bin/apply-cmdline.sh /run/nightfall/menu.tsv.def "$CMDLINE_FILE" > /run/nightfall/menu.tsv.cl \
       && [ -s /run/nightfall/menu.tsv.cl ]; then
        cat /run/nightfall/menu.tsv.cl > /run/nightfall/menu.tsv
    else
        warn "saved command lines not applied (continuing without them)"
        cat /run/nightfall/menu.tsv.def > /run/nightfall/menu.tsv
    fi
}

build_menu_files

# Fallback target if the picker itself fails for any reason (no touch
# device, no DRM output, crash, ...).
default_line=$(head -n1 /run/nightfall/menu.tsv)
default_linux=$(printf '%s' "$default_line" | cut -f2)
default_initrd=$(printf '%s' "$default_line" | cut -f3)
default_cmdline=$(printf '%s' "$default_line" | cut -f4)

# The Slate's panel is mounted rotated: 270 is upright, confirmed on
# real hardware. ui/nightfall.c defaults to 0 when this is unset, which is
# correct as a library default but wrong for the only machine this
# initramfs is ever built for - so set it here rather than leaving the
# first boot to come up sideways. Same transform drives touch, so an
# unset value is cosmetic (taps still land on the buttons you see)
# rather than broken - which is exactly why it could go unnoticed.
# Starting orientation and auto-rotate, settable from /boot - same
# pattern and same reasons as nightfall-timeout above.
#
# ORDER MATTERS HERE. This runs BEFORE the board-based default below, so a
# valid file sets NIGHTFALL_ROTATE and the default leaves it alone, while an
# absent or invalid one leaves it unset and the default supplies 270 (a
# Nocturne) or 0 (anything else). Nightfall's own parser maps anything that
# is not exactly 90/180/270 to ROT_0 - a sensible library default and the
# wrong one for the Slate panel, where 0 is sideways - so garbage must never
# be passed through to reach it.
#
# Lower stakes than the timeout, and deliberately treated that way: a
# wrong orientation is sideways but still usable, since touch goes
# through the same transform. Strict parsing and ignore-on-garbage is
# enough. `read`, not `head | tr` - tr is not an applet in this image.
ROTATE_FILE=$BOOTDIR/nightfall-rotate
AUTOROTATE_FILE=$BOOTDIR/nightfall-autorotate
if [ -f "$ROTATE_FILE" ]; then
    _r=""
    # `|| :`, not `|| _r=""` - see the build-id read above: a
    # newline-less file makes read return 1 at EOF despite
    # assigning the value correctly, and the old pattern wiped it.
    read -r _r < "$ROTATE_FILE" 2>/dev/null || :
    case "$_r" in
        0|90|180|270) NIGHTFALL_ROTATE=$_r
                      stage "starting rotation ${_r} (from nightfall-rotate)" ;;
        *)            warn "ignoring $ROTATE_FILE: expected 0, 90, 180 or 270" ;;
    esac
fi
if [ -f "$AUTOROTATE_FILE" ]; then
    _a=""
    # `|| :`, not `|| _a=""` - see the build-id read above: a
    # newline-less file makes read return 1 at EOF despite
    # assigning the value correctly, and the old pattern wiped it.
    read -r _a < "$AUTOROTATE_FILE" 2>/dev/null || :
    case "$_a" in
        # Normalised to 0/1 on the way out, so Nightfall only ever sees
        # the two values its own parser is known to handle.
        1|on)  NIGHTFALL_AUTOROTATE=1; export NIGHTFALL_AUTOROTATE
               stage "auto-rotate on (from nightfall-autorotate)" ;;
        0|off) NIGHTFALL_AUTOROTATE=0; export NIGHTFALL_AUTOROTATE
               stage "auto-rotate off (from nightfall-autorotate)" ;;
        # Garbage keeps auto-rotate ON, the default. An unreadable file
        # should not silently pin the rotation.
        *)     warn "ignoring $AUTOROTATE_FILE: expected 1, 0, on or off" ;;
    esac
fi

# The boot screens - the spinner before the menu and the booting screen -
# and how long they stay up. Same pattern as the settings above, for the
# fixer's GUI. Cosmetic, so validated for correctness only: garbage is
# ignored and Nightfall's defaults apply (screens on, 1500ms).
SPLASH_FILE=$BOOTDIR/nightfall-splash
SPLASH_MS_FILE=$BOOTDIR/nightfall-splash-ms
if [ -f "$SPLASH_FILE" ]; then
    _s=""
    # `|| :`, not `|| _s=""` - see the build-id read above: a
    # newline-less file makes read return 1 at EOF despite
    # assigning the value correctly, and the old pattern wiped it.
    read -r _s < "$SPLASH_FILE" 2>/dev/null || :
    case "$_s" in
        1|on)  NIGHTFALL_SPLASH=1; export NIGHTFALL_SPLASH
               stage "boot screens on (from nightfall-splash)" ;;
        0|off) NIGHTFALL_SPLASH=0; export NIGHTFALL_SPLASH
               stage "boot screens off (from nightfall-splash)" ;;
        *)     warn "ignoring $SPLASH_FILE: expected 1, 0, on or off" ;;
    esac
fi
if [ -f "$SPLASH_MS_FILE" ]; then
    _m=""
    # `|| :`, not `|| _m=""` - see the build-id read above: a
    # newline-less file makes read return 1 at EOF despite
    # assigning the value correctly, and the old pattern wiped it.
    read -r _m < "$SPLASH_MS_FILE" 2>/dev/null || :
    case "$_m" in
        ''|*[!0-9]*)
            warn "ignoring $SPLASH_MS_FILE: not a plain number of milliseconds" ;;
        *)
            if [ "$_m" -le 10000 ]; then
                NIGHTFALL_SPLASH_MIN_MS=$_m; export NIGHTFALL_SPLASH_MIN_MS
                stage "boot screens shown for at least ${_m}ms (from nightfall-splash-ms)"
            else
                warn "ignoring $SPLASH_MS_FILE: ${_m}ms is over the 10000ms limit"
            fi ;;
    esac
fi

# The default for a rotation nobody set (no /boot/nightfall-rotate file, no
# NIGHTFALL_ROTATE on the kernel command line). 270 is right for exactly one
# machine - the Slate's panel is mounted rotated - and sideways on every
# other: this image used to be built for that one machine only, so a flat
# 270 was correct. It is not now. So: 270 for a board that says it is a
# Nocturne, 0 for any board that says it is something else.
#
# FAIL-SAFE FOR THE SLATE, deliberately: if the board name cannot be read at
# all (no /sys/class/dmi/id - a kernel without CONFIG_DMIID, which the Slate
# picker kernel does have, but that is exactly the kind of thing that gets
# stripped later) the answer is still 270, the historical behaviour. Only a
# board that POSITIVELY identifies as not-a-Nocturne gets 0, so nothing that
# worked on the Slate can start coming up sideways because a sysfs file went
# missing. An empty-but-readable name (some VMs) counts as "not a Nocturne".
_board=""
_board_known=""
if [ -r /sys/class/dmi/id/board_name ]; then
    _board_known=1
    # `|| :`, not `|| _board=""` - same newline-less-file gotcha as above.
    read -r _board < /sys/class/dmi/id/board_name 2>/dev/null || :
fi
if [ -z "${NIGHTFALL_ROTATE:-}" ]; then
    case "$_board_known:$_board" in
        :*)                    NIGHTFALL_ROTATE=270
                               stage "rotation 270 (default: board name unreadable, assuming the Slate)" ;;
        1:Nocturne*|1:nocturne*) NIGHTFALL_ROTATE=270
                               stage "rotation 270 (default: board is a Nocturne)" ;;
        *)                     NIGHTFALL_ROTATE=0
                               stage "rotation 0 (default: board is '${_board}', not a Nocturne)" ;;
    esac
fi
export NIGHTFALL_ROTATE

# Back up / Restore is a Slate feature: it exists because the Slate is a
# keyboardless tablet with no other way to get a safety copy of itself, and
# it is not wanted on a general PC (Bob's call). So the menu row shows on a
# Nocturne and is hidden on any board that says it is something else. Same
# fail-safe as the rotation default: a board name that cannot be read at all
# keeps the historical behaviour (shown), so a missing sysfs file can never
# take a feature away from the machine it was built for. Precedence, most
# specific first: /boot/nightfall-backup (1/on or 0/off), NIGHTFALL_BACKUP on
# the kernel command line, then the board. Only the MENU is gated - the
# scripts stay in the image and nothing else reads this.
BACKUP_FILE=$BOOTDIR/nightfall-backup
if [ -f "$BACKUP_FILE" ]; then
    _bk=""
    # `|| :`, not `|| _bk=""` - see the build-id read above.
    read -r _bk < "$BACKUP_FILE" 2>/dev/null || :
    case "$_bk" in
        1|on)  NIGHTFALL_BACKUP=1
               stage "backup menu on (from nightfall-backup)" ;;
        0|off) NIGHTFALL_BACKUP=0
               stage "backup menu off (from nightfall-backup)" ;;
        *)     warn "ignoring $BACKUP_FILE: expected 1, 0, on or off" ;;
    esac
fi
if [ -z "${NIGHTFALL_BACKUP:-}" ]; then
    case "$_board_known:$_board" in
        :*)                      NIGHTFALL_BACKUP=1
                                 stage "backup menu on (default: board name unreadable, assuming the Slate)" ;;
        1:Nocturne*|1:nocturne*) NIGHTFALL_BACKUP=1
                                 stage "backup menu on (default: board is a Nocturne)" ;;
        *)                       NIGHTFALL_BACKUP=0
                                 stage "backup menu off (default: board is '${_board}', not a Nocturne)" ;;
    esac
fi
export NIGHTFALL_BACKUP

# stderr goes to a file rather than the console: it carries picker's own
# diagnostics (chosen touch device, DRM open failures) plus LVGL's log,
# which is the single most useful thing to have when picker fails, and
# on the console it scrolls past behind the kexec faster than anyone can
# read it. It gets replayed to the screen on the failure path below, and
# copied into the boot log either way.
# NOTE: picker waits for its own DRM and touch devices (NIGHTFALL_WAIT_SECS,
# see ui/nightfall.c). init deliberately does NOT gate on them here.
#
# It used to, and the check was worse than useless: "does any
# /dev/input/event* exist" was satisfied instantly by the unrelated
# event0-2 present from the very start, so init waited zero seconds and
# picker still exited with "no touch input device found" while the real
# controller was merely a second behind. A proxy for a check is a second
# definition of the thing, and it disagreed with the real one. Only
# touch_open() knows what a usable touch device is, so only picker can
# usefully wait for one.
# Installable tarballs for the Install menu. Entirely optional: a
# failure here just means that menu comes up empty, which must never be
# a reason not to boot.
/bin/discover-tarballs.sh /mnt/root > /run/nightfall/tarballs.tsv 2>/dev/null || \
    : > /run/nightfall/tarballs.tsv

# External drives, and the backups already on them. The same script
# picker re-runs when the user taps Rescan: the drive usually CANNOT be
# present at boot, because with no keyboard there is no way to stop the
# firmware booting a bootable USB stick instead of the picker. So this
# is the first look, not the only one.
/bin/scan-drives.sh "$REAL_ROOT_DEV" /mnt/root \
    /run/nightfall/targets.tsv /run/nightfall/backups.tsv /run/nightfall/bootable.tsv 2>/dev/null || {
        : > /run/nightfall/targets.tsv
        : > /run/nightfall/backups.tsv
        : > /run/nightfall/bootable.tsv
    }

# Under kernel lockdown the legacy kexec_load syscall is refused, and the
# final handoff below exec()s kexec-boot.sh in place of PID 1 - so that
# refusal used to end in a kernel panic with nothing on screen to say why.
# Ask once, up front: the reason goes to the UI (which then explains instead
# of offering a boot that cannot work) and guards the exec at the bottom.
# Only an exit status of exactly 1 means blocked; a missing script (an image
# built before this existed) or any other failure means "cannot tell", never
# "blocked" - refusing to boot a machine that would have worked is worse.
kexec_block=$(/bin/kexec-preflight.sh 2>/dev/null); _pf=$?
if [ "$_pf" = 1 ] && [ -n "$kexec_block" ]; then
    warn "kexec is blocked: $kexec_block"
    NIGHTFALL_KEXEC_BLOCKED=$kexec_block
    export NIGHTFALL_KEXEC_BLOCKED
else
    kexec_block=""
fi

# grub.cfg changes when a kernel is installed, so the menu has to be
# rebuilt from it - otherwise the list still omits what was just added,
# which looks exactly like the install having done nothing.
refresh_menu() {
    if discover_kernels; then
        build_menu_files
        default_line=$(head -n1 /run/nightfall/menu.tsv)
        default_linux=$(printf '%s' "$default_line" | cut -f2)
        default_initrd=$(printf '%s' "$default_line" | cut -f3)
        default_cmdline=$(printf '%s' "$default_line" | cut -f4)
    fi
    /bin/discover-tarballs.sh /mnt/root > /run/nightfall/tarballs.tsv 2>/dev/null || :
    # The drive lists go stale for the same reason the kernel list does:
    # taking a backup adds one, deleting a backup removes one, and
    # coming back to a menu that still lists what you just deleted looks
    # exactly like the delete having done nothing. Nightfall never
    # mounts anything itself, so this has to happen out here.
    /bin/scan-drives.sh "$REAL_ROOT_DEV" /mnt/root \
        /run/nightfall/targets.tsv /run/nightfall/backups.tsv /run/nightfall/bootable.tsv 2>/dev/null || :
}

# Installing a kernel returns to the menu rather than booting, so the
# newly installed entry can be picked immediately - update-grub has
# already rewritten grub.cfg by then, so re-running discovery is what
# makes it appear. Bounded, because an install that somehow kept
# re-requesting itself must not become a boot loop: after this many
# rounds we stop offering and just boot something.
install_rounds=0
# Counted separately from install_rounds, because the two are bounded
# for different reasons. An install can re-request itself with nobody
# present, so three is a deliberately tight leash. A reload only ever
# happens because someone tapped "Back to menu" on the finished screen,
# and doing several backup deletions in a row is the normal way to free
# space on a full drive - sharing the install leash meant the fourth tap
# silently booted instead of returning to the menu. Still bounded, since
# a Nightfall that crashed instantly and kept asking to reload must not
# become a boot loop either.
reload_rounds=0
# A live-USB boot has genuine, ordinary ways to fail - the drive gets
# unplugged mid-mount, the ISO turns out not to be a supported live
# image - none of which are a reason to strand the machine. Bounded for
# the same reason as the other two: a request that somehow kept
# re-firing must not become a loop that never lets the menu back on
# screen.
live_boot_rounds=0
# Arming a firmware boot has the same genuine, ordinary failure modes as
# a live-USB boot (drive unplugged, efibootmgr refuses) plus one of its
# own (no efivarfs - see the mount attempt above) - bounded for the same
# reason: a repeating request must not become a loop the menu never
# comes back from.
boot_external_rounds=0
while :; do
stage "running nightfall"
if /bin/nightfall /run/nightfall/menu.tsv /run/nightfall/tarballs.tsv "$CMDLINE_FILE" \
        /run/nightfall/targets.tsv /run/nightfall/backups.tsv /run/nightfall/bootable.tsv \
        > /run/nightfall/selected 2>/run/nightfall/nightfall.stderr; then
    nightfall_rc=0
    # Sets SELECTED_LINUX/INITRD/CMDLINE and SELECTED_BY, or SET_DEFAULT=1
    # if "Set Default" was used, or INSTALL_TARBALL if the user chose to
    # install instead of boot. Exactly one of the last two.
    INSTALL_TARBALL=
    RELOAD=
    POWER_ACTION=
    LIVE_BOOT_TARGET=
    LIVE_BOOT_ISO=
    BOOT_EXTERNAL_PART=
    BOOT_EXTERNAL_LOADER=
    SET_CMDLINE=
    . /run/nightfall/selected

    # picker ran the install itself and showed its progress, so there is
    # nothing to install here - only a stale kernel list to refresh.
    # Deliberately a different key from INSTALL_TARBALL: treating them
    # the same would install the same tarball a second time.
    # Restart / Power off. Nightfall cannot do this itself and should
    # not: init owns the root mount, so it is the one that can put the
    # filesystem down cleanly first. Same split as SET_DEFAULT.
    #
    # Restart is also the answer to "take me to the GRUB menu" - GRUB
    # handed off long before Nightfall started, so there is nothing to
    # return to; you reboot and GRUB's menu comes up on the way back.
    if [ -n "$POWER_ACTION" ]; then
        stage "$POWER_ACTION requested from Nightfall"
        save_log "$POWER_ACTION requested" 2>/dev/null || :
        sync
        umount /mnt/root 2>/dev/null || :
        sync
        case "$POWER_ACTION" in
            poweroff) echo "nightfall: powering off" >&2; poweroff -f ;;
            *)        echo "nightfall: restarting" >&2;   reboot -f ;;
        esac
        # -f does the syscall directly, so this is unreachable. If some
        # build of busybox signals PID 1 instead - which is this script -
        # do not fall through into booting something the user did not
        # choose.
        sleep 10
        rescue "$POWER_ACTION did not take effect"
    fi

    # Boot a live USB - a Ventoy-style rescue image on an external drive.
    # A DIFFERENT contract from SELECTED_LINUX/INITRD/CMDLINE below: that
    # one names a real kernel at a path relative to /mnt/root, and this
    # one names a partition plus a path INSIDE an ISO file loop-mounted
    # from it - reusing kexec-boot.sh's argument shape would only make
    # both scripts pretend those are the same kind of thing.
    #
    # Deliberately NOT exec'd. The handoff below can exec into
    # kexec-boot.sh because by the time it runs, SELECTED_LINUX has
    # already been validated hard enough that a failure there would be an
    # init BUG, not user error - see the file header. boot-live-iso.sh
    # has no such guarantee: this runs as a normal command, so a failure
    # returns to the menu rather than taking PID 1 down with it.
    if [ -n "$LIVE_BOOT_TARGET" ]; then
        live_boot_rounds=$((live_boot_rounds + 1))
        # continue lives ONLY inside this branch, same shape as
        # INSTALL_TARBALL below. Put outside the if/else it would
        # unconditionally re-loop even after the leash trips - a request
        # that keeps repeating would spin here forever instead of ever
        # reaching "booting instead", since nothing about the loop
        # changes between rounds to make it stop on its own.
        if [ "$live_boot_rounds" -le 3 ]; then
            stage "booting a specific ISO: $LIVE_BOOT_ISO on $LIVE_BOOT_TARGET"
            echo "" >&2
            echo "nightfall: booting a live image - this can take a minute." >&2
            # No install.rc-style dance needed here, unlike
            # install-kernel.sh's invocation: this never branches on the
            # exit status, because SUCCESS NEVER RETURNS - boot-live-iso.sh's
            # own kexec -e replaces this whole process. Reaching the line
            # after the pipe at all, for any reason, already means it did
            # not take - so there is no status left for tee to mask.
            /bin/boot-live-iso.sh "$LIVE_BOOT_TARGET" "$LIVE_BOOT_ISO" 2>&1 \
                | tee -a /run/nightfall/live-boot.log >&2
            warn "live-USB boot did not take - see the messages above"
            echo "nightfall: nothing on this machine was changed." >&2
            sleep "${NIGHTFALL_FALLBACK_PAUSE:-8}"
            continue
        fi
        warn "too many live-USB boot attempts - booting instead"
    fi

    # Boot an external drive - hand the WHOLE drive to firmware instead of
    # trying to understand what's on it (a Ventoy stick, another live-USB
    # tool's drive, a separate OS on a USB disk). Its own contract, not
    # LIVE_BOOT_TARGET: this names a partition plus the loader path
    # firmware should run, not a kernel/initrd/ISO. See
    # boot-external-drive.sh's own header for the mechanism.
    #
    # Unlike live-USB boot, success here does NOT end in a kexec -
    # boot-external-drive.sh only arms a one-shot UEFI BootNext entry, so
    # getting to the drive from here needs an actual restart, which this
    # does itself using the same sequence POWER_ACTION=reboot uses above.
    # Deliberately NOT exec'd, same reasoning as boot-live-iso.sh: a
    # failure here is ordinary (drive unplugged, no efivarfs, efibootmgr
    # refuses) and must return to the menu, not take PID 1 down with it.
    if [ -n "$BOOT_EXTERNAL_PART" ]; then
        boot_external_rounds=$((boot_external_rounds + 1))
        # continue lives ONLY inside this branch, same shape as every
        # other leashed action above - outside it, the loop would keep
        # spinning even after the leash trips.
        if [ "$boot_external_rounds" -le 3 ]; then
            stage "arming a firmware boot into $BOOT_EXTERNAL_PART"
            echo "" >&2
            echo "nightfall: preparing to boot an external drive..." >&2
            # Pipeline exit status is tee's, not the script's - the same
            # trap INSTALL_TARBALL's own dance below exists to avoid - so
            # the real status comes back through a file instead.
            { /bin/boot-external-drive.sh "$BOOT_EXTERNAL_PART" "$BOOT_EXTERNAL_LOADER" 2>&1; \
              echo $? > /run/nightfall/boot-external.rc; } \
              | tee -a /run/nightfall/boot-external.log >&2
            if [ "$(cat /run/nightfall/boot-external.rc 2>/dev/null || echo 1)" = 0 ]; then
                stage "BootNext armed - restarting into $BOOT_EXTERNAL_PART"
                save_log "restarting into $BOOT_EXTERNAL_PART" 2>/dev/null || :
                sync
                umount /mnt/root 2>/dev/null || :
                sync
                echo "nightfall: restarting into the external drive" >&2
                reboot -f
                sleep 10
                rescue "restart did not take effect after arming an external-drive boot"
            fi
            warn "external-drive boot did not take - see the messages above"
            echo "nightfall: nothing on this machine was changed." >&2
            sleep "${NIGHTFALL_FALLBACK_PAUSE:-8}"
            continue
        fi
        warn "too many external-drive boot attempts - booting instead"
    fi

    if [ -n "$RELOAD" ]; then
        reload_rounds=$((reload_rounds + 1))
        if [ "$reload_rounds" -le "${NIGHTFALL_MAX_RELOADS:-12}" ]; then
            stage "reloading the menu after work done inside Nightfall"
            refresh_menu
            continue
        fi
        warn "too many reloads - booting instead"
    fi

    if [ -n "$INSTALL_TARBALL" ]; then
        install_rounds=$((install_rounds + 1))
        if [ "$install_rounds" -gt 3 ]; then
            warn "too many install rounds - booting instead"
        else
            stage "installing $INSTALL_TARBALL"
            echo "" >&2
            echo "nightfall: installing a kernel - this takes several minutes." >&2
            echo "nightfall: do NOT power off." >&2
            # Captured as well as shown: on the console it scrolls past
            # behind the reboot, and "the install failed" without the
            # reason is exactly the blind spot the boot log exists to
            # close. tee keeps both - but a pipeline reports the exit
            # status of its LAST command, so tee's success would mask an
            # install failure entirely (it did, until a test caught it).
            # busybox ash has no PIPESTATUS, so the status comes back
            # through a file instead of being inferred.
            { /bin/install-kernel.sh /mnt/root "$INSTALL_TARBALL" 2>&1; \
              echo $? > /run/nightfall/install.rc; } \
              | tee -a /run/nightfall/install.log >&2
            if [ "$(cat /run/nightfall/install.rc 2>/dev/null || echo 1)" = 0 ]; then
                stage "install succeeded"
                echo "nightfall: install finished - returning to the menu." >&2
            else
                warn "INSTALL FAILED for $INSTALL_TARBALL"
                echo "nightfall: install FAILED - see the message above." >&2
                echo "nightfall: nothing was removed; existing kernels still boot." >&2
            fi
            sleep "${NIGHTFALL_INSTALL_PAUSE:-6}"

            refresh_menu
            continue
        fi
    fi
else
    nightfall_rc=$?
    nightfall_failed="nightfall exited $nightfall_rc"
    SELECTED_LINUX="$default_linux"
    SELECTED_INITRD="$default_initrd"
    SELECTED_CMDLINE="$default_cmdline"
fi
break
done

if [ -z "$SELECTED_LINUX" ]; then
    nightfall_failed="${nightfall_failed:-nightfall produced no selection}"
    SELECTED_LINUX="$default_linux"
    SELECTED_INITRD="$default_initrd"
    SELECTED_CMDLINE="$default_cmdline"
fi

# The fallback is silent by design, and that is precisely what made the
# first boot attempt undebuggable - it looks identical to GRUB ignoring
# the selection. Say so on screen, show why, and hold long enough to
# read or photograph it before the kexec wipes the display.
if [ -n "${nightfall_failed:-}" ]; then
    release_display
    warn "FALLBACK: $nightfall_failed"
    echo "" >&2
    echo "nightfall: ================================================" >&2
    echo "nightfall: the menu could not be shown ($nightfall_failed)." >&2
    echo "nightfall: booting the default entry instead:" >&2
    echo "nightfall:   $SELECTED_LINUX" >&2
    echo "nightfall: last lines of Nightfall's own output:" >&2
    # Redirection order matters: point stdout at the real stderr FIRST,
    # then silence tail's own errors. The other order aims fd1 at the
    # /dev/null that fd2 has just become, and this replay - the only
    # copy anyone without SSH will ever see - vanishes.
    tail -n15 /run/nightfall/nightfall.stderr >&2 2>/dev/null || echo "nightfall:   (none)" >&2
    echo "nightfall: full details saved to /boot/nightfall-last-boot.log" >&2
    echo "nightfall: ================================================" >&2
    sleep "${NIGHTFALL_FALLBACK_PAUSE:-8}"
fi

if [ -z "$SELECTED_LINUX" ]; then
    rescue "no usable kernel entry to boot"
fi

# Persisting "Set Default" means briefly remounting the real root
# read-write, which /mnt/root was deliberately mounted read-only to
# avoid needing at all (keeps the picker's normal blast radius small -
# see boot-integration/README.md). This is the one exception, and it's
# best-effort: a failure here should never block booting into what the
# user actually just chose, so every step just logs and moves on
# rather than treating persistence as required.
# picker asks for a saved command line the same way it asks for a
# default: it never touches the mount itself. SET_CMDLINE is
# "<kernel>\t<cmdline>", or "<kernel>\t" alone to forget that kernel's
# override and go back to whatever grub.cfg says.
if [ -n "${SET_CMDLINE:-}" ]; then
    if mount -o remount,rw /mnt/root 2>/dev/null; then
        _ck=$(printf '%s' "$SET_CMDLINE" | cut -f1)
        _cv=$(printf '%s' "$SET_CMDLINE" | cut -f2)
        # Drop any existing line for this kernel, then re-add it if the
        # new value is non-empty. awk rather than sed: the key is a path
        # full of slashes.
        if [ -f "$CMDLINE_FILE" ]; then
            awk -F'\t' -v k="$_ck" '$1 != k' "$CMDLINE_FILE" > /run/nightfall/cl.new 2>/dev/null || : > /run/nightfall/cl.new
        else
            : > /run/nightfall/cl.new
        fi
        [ -n "$_cv" ] && printf '%s\t%s\n' "$_ck" "$_cv" >> /run/nightfall/cl.new
        if cat /run/nightfall/cl.new > "$CMDLINE_FILE" 2>/dev/null; then
            if [ -n "$_cv" ]; then stage "saved command line for $_ck"
            else stage "cleared the saved command line for $_ck"; fi
        else
            echo "nightfall: failed to save the command line (continuing anyway)" >&2
        fi
        sync 2>/dev/null || true
        mount -o remount,ro /mnt/root 2>/dev/null || \
            echo "nightfall: failed to remount root read-only after saving the command line" >&2
    else
        echo "nightfall: could not remount rw to save the command line (continuing anyway)" >&2
    fi
fi

if [ "${SET_DEFAULT:-}" = "1" ]; then
    if mount -o remount,rw /mnt/root; then
        if ! printf '%s\n' "$SELECTED_LINUX" > "$DEFAULT_MARKER" 2>/dev/null; then
            echo "nightfall: failed to write default preference (continuing anyway)" >&2
        fi
        mount -o remount,ro /mnt/root || \
            echo "nightfall: failed to remount root read-only after saving default (continuing anyway)" >&2
    else
        echo "nightfall: failed to remount root read-write to save default preference (continuing anyway)" >&2
    fi
fi

if [ -n "${nightfall_failed:-}" ]; then
    save_log "fell back: $nightfall_failed"
else
    save_log "booted user selection"
fi

# exec()ing kexec-boot.sh under lockdown ends in "Attempted to kill init!" -
# a rescue shell that says why is the only failure a person can act on.
if [ -n "$kexec_block" ]; then
    rescue "cannot boot $SELECTED_LINUX: $kexec_block"
fi

stage "kexec into $SELECTED_LINUX"
exec /sbin/kexec-boot.sh /mnt/root "$SELECTED_LINUX" "$SELECTED_INITRD" "$SELECTED_CMDLINE"
